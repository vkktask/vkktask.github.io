<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Vivek Kumar | AI Governance Architect and Speaker</title>
  <meta name="description" content="Vivek Kumar helps leaders govern what AI can reach, combine, and act on. Speaker, AI governance architect, creator of PAARA, AI2030 Global Fellow, and peer reviewer for NeurIPS, AIES, Elsevier and Springer.">
  <meta name="theme-color" content="#11110f">
  <meta property="og:type" content="website">
  <meta property="og:title" content="Vivek Kumar | AI Governance Architect and Speaker">
  <meta property="og:description" content="Govern what AI can reach. Practical governance for generative and agentic AI. Creator of PAARA and AI2030 Global Fellow.">
  <meta property="og:image" content="https://vkktask.github.io/assets/vivek-kumar.jpg">
  <meta property="og:url" content="https://vkktask.github.io/">
  <link rel="canonical" href="https://vkktask.github.io/">
  <style>
    :root {
      --ink: #11110f;
      --ink-soft: #1e1e1a;
      --paper: #f5f2ea;
      --white: #fffdf8;
      --line: #cdc8bc;
      --muted: #69665f;
      --signal: #e4512e;
      --signal-dark: #b9361b;
      --sage: #3f665e;
      --max: 1180px;
      --nav: 68px;
    }

    * { box-sizing: border-box; }
    html { scroll-behavior: smooth; }
    body {
      margin: 0;
      background: var(--paper);
      color: var(--ink);
      font-family: "Helvetica Neue", Helvetica, Arial, sans-serif;
      font-size: 16px;
      line-height: 1.6;
      letter-spacing: 0;
      -webkit-font-smoothing: antialiased;
    }
    body.menu-open { overflow: hidden; }
    img { display: block; max-width: 100%; }
    a { color: inherit; text-decoration: none; }
    button, input { font: inherit; }
    button { color: inherit; }
    :focus-visible { outline: 3px solid var(--signal); outline-offset: 4px; }
    ::selection { background: var(--signal); color: var(--white); }

    .skip-link {
      position: fixed;
      left: 16px;
      top: -80px;
      z-index: 200;
      background: var(--white);
      color: var(--ink);
      padding: 10px 14px;
      border: 1px solid var(--ink);
      transition: top 160ms ease;
    }
    .skip-link:focus { top: 12px; }
    .shell { width: min(var(--max), calc(100% - 48px)); margin: 0 auto; }
    .eyebrow {
      margin: 0 0 18px;
      color: var(--signal);
      font-size: 12px;
      font-weight: 700;
      letter-spacing: .16em;
      line-height: 1.4;
      text-transform: uppercase;
    }
    .serif { font-family: Georgia, "Times New Roman", serif; }
    .arrow-link {
      display: inline-flex;
      align-items: center;
      gap: 12px;
      font-weight: 700;
      border-bottom: 1px solid currentColor;
      padding-bottom: 3px;
      transition: color 160ms ease, gap 160ms ease;
    }
    .arrow-link:hover { color: var(--signal); gap: 17px; }

    .site-nav {
      position: sticky;
      top: 0;
      z-index: 100;
      height: var(--nav);
      background: rgba(17, 17, 15, .94);
      color: var(--white);
      border-bottom: 1px solid rgba(255, 255, 255, .14);
      backdrop-filter: blur(14px);
    }
    .nav-inner {
      height: 100%;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 32px;
    }
    .brand {
      display: inline-flex;
      align-items: center;
      gap: 12px;
      color: var(--white);
      font-size: 14px;
      font-weight: 800;
      letter-spacing: .08em;
      line-height: 1;
      text-transform: uppercase;
      white-space: nowrap;
    }
    .brand-mark { width: 9px; height: 9px; background: var(--signal); }
    .nav-links { display: flex; align-items: center; gap: 28px; }
    .nav-links a {
      color: #d8d4cb;
      font-size: 13px;
      font-weight: 600;
      transition: color 160ms ease;
    }
    .nav-links a:hover { color: var(--white); }
    .nav-links .nav-contact { color: var(--white); border-bottom: 1px solid var(--signal); }
    .menu-button {
      display: none;
      border: 0;
      background: none;
      padding: 10px 0 10px 12px;
      color: var(--white);
      font-size: 13px;
      font-weight: 700;
      letter-spacing: .06em;
      text-transform: uppercase;
      cursor: pointer;
    }

    .hero {
      position: relative;
      min-height: calc(100svh - 112px);
      overflow: hidden;
      background: var(--ink);
      color: var(--white);
      isolation: isolate;
    }
    .hero-image {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: 72% 8%;
      filter: saturate(.86) contrast(1.03);
      z-index: -3;
      transform: scale(1.015);
      animation: settle 1.3s cubic-bezier(.2,.7,.2,1) both;
    }
    .hero::before {
      content: "";
      position: absolute;
      inset: 0;
      z-index: -2;
      background: linear-gradient(90deg, rgba(17,17,15,.98) 0%, rgba(17,17,15,.91) 41%, rgba(17,17,15,.18) 70%, rgba(17,17,15,.06) 100%);
    }
    .hero::after {
      content: "";
      position: absolute;
      left: 0;
      right: 0;
      bottom: 0;
      height: 18%;
      z-index: -1;
      background: linear-gradient(0deg, rgba(17,17,15,.7), transparent);
    }
    .hero-inner {
      min-height: calc(100svh - 112px);
      display: flex;
      align-items: center;
      padding: 72px 0 66px;
    }
    .hero-copy { width: min(660px, 61%); }
    .hero-kicker {
      margin: 0 0 24px;
      color: #e8e3d8;
      font-size: 13px;
      font-weight: 700;
      letter-spacing: .13em;
      text-transform: uppercase;
      animation: rise 650ms 100ms both;
    }
    .hero h1 {
      margin: 0;
      color: var(--white);
      font-size: 112px;
      font-weight: 800;
      line-height: .82;
      letter-spacing: 0;
      text-transform: uppercase;
      animation: rise 720ms 180ms both;
    }
    .hero-line {
      display: block;
      margin-top: 28px;
      color: var(--white);
      font-family: Georgia, "Times New Roman", serif;
      font-size: 66px;
      font-style: italic;
      font-weight: 400;
      line-height: 1;
      text-transform: none;
    }
    .hero-line em { color: var(--signal); font-style: inherit; }
    .hero-summary {
      max-width: 600px;
      margin: 30px 0 0;
      color: #d7d2c8;
      font-size: 20px;
      line-height: 1.55;
      animation: rise 720ms 280ms both;
    }
    .hero-actions {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 18px;
      margin-top: 36px;
      animation: rise 720ms 380ms both;
    }
    .button {
      display: inline-flex;
      min-height: 48px;
      align-items: center;
      justify-content: center;
      gap: 12px;
      padding: 12px 20px;
      border: 1px solid transparent;
      border-radius: 2px;
      font-size: 14px;
      font-weight: 800;
      cursor: pointer;
      transition: background 160ms ease, color 160ms ease, border-color 160ms ease, transform 160ms ease;
    }
    .button:hover { transform: translateY(-2px); }
    .button-primary { background: var(--signal); color: var(--white); }
    .button-primary:hover { background: #ff6843; }
    .button-secondary { border-color: rgba(255,255,255,.46); color: var(--white); }
    .button-secondary:hover { border-color: var(--white); background: rgba(255,255,255,.08); }
    .hero-role {
      position: absolute;
      right: max(24px, calc((100% - var(--max)) / 2));
      bottom: 24px;
      max-width: 410px;
      margin: 0;
      color: #efebe1;
      font-size: 12px;
      font-weight: 700;
      letter-spacing: .12em;
      line-height: 1.55;
      text-align: right;
      text-transform: uppercase;
      animation: rise 720ms 500ms both;
    }
    .hero-role span { color: var(--signal); }

    .proof-strip { border-bottom: 1px solid var(--line); background: var(--white); }
    .proof-inner {
      min-height: 88px;
      display: grid;
      grid-template-columns: 1.15fr 1fr 1.2fr;
      align-items: center;
    }
    .proof-item {
      min-width: 0;
      padding: 18px 28px;
      border-right: 1px solid var(--line);
      color: var(--muted);
      font-size: 13px;
      line-height: 1.45;
    }
    .proof-item:first-child { padding-left: 0; }
    .proof-item:last-child { padding-right: 0; border-right: 0; }
    .proof-item strong { display: block; color: var(--ink); font-size: 15px; }

    .section { padding: 112px 0; }
    .section-header {
      display: grid;
      grid-template-columns: 180px minmax(0, 1fr);
      gap: 44px;
      margin-bottom: 58px;
      align-items: start;
    }
    .section-index {
      color: var(--signal);
      font-size: 12px;
      font-weight: 800;
      letter-spacing: .16em;
      text-transform: uppercase;
    }
    .section-title {
      max-width: 890px;
      margin: 0;
      font-family: Georgia, "Times New Roman", serif;
      font-size: 68px;
      font-weight: 400;
      line-height: 1.02;
    }
    .section-title em { color: var(--signal); font-style: italic; }
    .section-lede {
      max-width: 780px;
      margin: 24px 0 0;
      color: var(--muted);
      font-size: 22px;
      line-height: 1.55;
    }

    .perspective-grid {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(330px, .92fr);
      gap: 90px;
      align-items: start;
    }
    .perspective-copy p {
      max-width: 650px;
      margin: 0 0 24px;
      color: #3e3c37;
      font-size: 18px;
    }
    .question-list { border-top: 1px solid var(--ink); }
    .question {
      display: grid;
      grid-template-columns: 44px 1fr;
      gap: 12px;
      padding: 19px 0;
      border-bottom: 1px solid var(--line);
      align-items: baseline;
    }
    .question span { color: var(--signal); font-size: 12px; font-weight: 800; }
    .question p { margin: 0; font-size: 17px; font-weight: 700; line-height: 1.35; }

    .talks { background: var(--white); border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
    .talk-list { border-top: 2px solid var(--ink); }
    .talk { border-bottom: 1px solid var(--line); }
    .talk summary {
      display: grid;
      grid-template-columns: 88px minmax(0, 1fr) 46px;
      gap: 30px;
      align-items: center;
      padding: 34px 0;
      list-style: none;
      cursor: pointer;
    }
    .talk summary::-webkit-details-marker { display: none; }
    .talk-number { color: var(--signal); font-size: 13px; font-weight: 800; letter-spacing: .12em; }
    .talk-title { margin: 0; font-size: 38px; line-height: 1.15; }
    .talk-subtitle { margin: 8px 0 0; color: var(--muted); font-size: 15px; }
    .talk-toggle {
      position: relative;
      width: 42px;
      height: 42px;
      border: 1px solid var(--ink);
      border-radius: 50%;
    }
    .talk-toggle::before,
    .talk-toggle::after {
      content: "";
      position: absolute;
      left: 50%;
      top: 50%;
      width: 14px;
      height: 1px;
      background: var(--ink);
      transform: translate(-50%, -50%);
      transition: transform 180ms ease;
    }
    .talk-toggle::after { transform: translate(-50%, -50%) rotate(90deg); }
    .talk[open] .talk-toggle { background: var(--signal); border-color: var(--signal); }
    .talk[open] .talk-toggle::before,
    .talk[open] .talk-toggle::after { background: var(--white); }
    .talk[open] .talk-toggle::after { transform: translate(-50%, -50%) rotate(0); }
    .talk-detail {
      display: grid;
      grid-template-columns: 88px minmax(0, 1.3fr) minmax(280px, .8fr);
      gap: 30px;
      padding: 0 0 42px;
    }
    .talk-description { margin: 0; color: #3e3c37; font-size: 17px; }
    .talk-meta { border-left: 1px solid var(--line); padding-left: 28px; }
    .talk-meta h4 { margin: 0 0 8px; font-size: 12px; letter-spacing: .12em; text-transform: uppercase; }
    .talk-meta p, .talk-meta ul { margin: 0 0 18px; color: var(--muted); font-size: 14px; }
    .talk-meta ul { padding-left: 18px; }
    .talk-meta li { margin-bottom: 5px; }

    .paara { background: var(--ink); color: var(--white); }
    .paara .section-index { color: #ff7a57; }
    .paara .section-lede { color: #c7c2b8; }
    .paara-grid {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(360px, .85fr);
      gap: 78px;
      align-items: end;
    }
    .paara-word {
      margin: 0;
      color: var(--white);
      font-size: 156px;
      font-weight: 900;
      line-height: .75;
      letter-spacing: 0;
    }
    .paara-name { margin: 28px 0 0; color: #aaa59c; font-size: 14px; letter-spacing: .12em; text-transform: uppercase; }
    .paara-copy p { margin: 0 0 24px; color: #d6d1c8; font-size: 17px; }
    .paara-copy .arrow-link { color: #ff7a57; }
    .paara-steps {
      display: grid;
      grid-template-columns: repeat(7, 1fr);
      margin-top: 74px;
      border-top: 1px solid #494942;
      border-bottom: 1px solid #494942;
    }
    .paara-step { min-height: 136px; padding: 20px 14px 18px 0; border-right: 1px solid #494942; }
    .paara-step:last-child { border-right: 0; }
    .paara-step strong { display: block; color: #ff7a57; font-size: 12px; }
    .paara-step span { display: block; margin-top: 26px; font-size: 13px; line-height: 1.35; }

    .bio-grid {
      display: grid;
      grid-template-columns: minmax(280px, .68fr) minmax(0, 1.32fr);
      gap: 88px;
      align-items: start;
    }
    .bio-photo { position: sticky; top: calc(var(--nav) + 28px); }
    .bio-photo img { width: 100%; aspect-ratio: 4 / 5; object-fit: cover; object-position: 50% 22%; }
    .bio-photo figcaption { margin-top: 12px; color: var(--muted); font-size: 12px; }
    .bio-copy .intro {
      margin: 0 0 34px;
      font-family: Georgia, "Times New Roman", serif;
      font-size: 42px;
      line-height: 1.22;
    }
    .bio-copy > p { margin: 0 0 24px; color: #46433e; font-size: 17px; }
    .credential-line {
      margin-top: 38px;
      padding: 22px 0;
      border-top: 1px solid var(--ink);
      border-bottom: 1px solid var(--line);
      color: var(--muted);
      font-size: 14px;
      font-weight: 700;
      word-spacing: 14px;
    }

    .proof-work { background: #e9e6dd; }
    .work-list { border-top: 2px solid var(--ink); }
    .work-item {
      display: grid;
      grid-template-columns: 170px minmax(0, 1fr) 110px;
      gap: 28px;
      align-items: center;
      padding: 27px 0;
      border-bottom: 1px solid #bdb8ac;
    }
    .work-type { color: var(--signal-dark); font-size: 12px; font-weight: 800; letter-spacing: .12em; text-transform: uppercase; }
    .work-item h3 { margin: 0; font-size: 24px; line-height: 1.3; }
    .work-item p { margin: 5px 0 0; color: var(--muted); font-size: 14px; }
    .work-link { justify-self: end; color: var(--ink); font-size: 13px; font-weight: 800; border-bottom: 1px solid var(--ink); }
    .work-link:hover { color: var(--signal); border-color: var(--signal); }

    .recognition { background: var(--white); border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
    .award-list { display: grid; grid-template-columns: 1fr 1fr; border-top: 2px solid var(--ink); }
    .award { min-height: 158px; padding: 26px 26px 26px 0; border-bottom: 1px solid var(--line); }
    .award:nth-child(odd) { padding-right: 42px; border-right: 1px solid var(--line); }
    .award:nth-child(even) { padding-left: 42px; }
    .award-tag { color: var(--signal-dark); font-size: 12px; font-weight: 800; letter-spacing: .1em; text-transform: uppercase; }
    .award h3 { margin: 13px 0 0; font-size: 25px; line-height: 1.25; }
    .award p { margin: 9px 0 0; color: var(--muted); font-size: 14.5px; }

    .review-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(300px, .72fr); gap: 78px; align-items: start; }
    .review-list { border-top: 2px solid var(--ink); }
    .review-item {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 26px;
      align-items: baseline;
      padding: 21px 0;
      border-bottom: 1px solid var(--line);
    }
    .review-item h3 { margin: 0; font-size: 20px; line-height: 1.3; }
    .review-item p { margin: 5px 0 0; color: var(--muted); font-size: 14px; }
    .review-role { color: var(--signal-dark); font-size: 12px; font-weight: 800; letter-spacing: .1em; text-transform: uppercase; white-space: nowrap; }
    .review-aside { border-top: 2px solid var(--ink); padding-top: 26px; }
    .review-figure { display: block; font-family: Georgia, "Times New Roman", serif; font-size: 76px; line-height: .9; }
    .review-figure-label { display: block; margin-top: 14px; color: var(--muted); font-size: 15px; line-height: 1.5; }
    .review-aside p { margin: 26px 0 0; color: var(--muted); font-size: 14px; }

    .paara-filings {
      display: grid;
      grid-template-columns: 230px minmax(0, 1fr);
      gap: 34px;
      margin-top: 58px;
      padding-top: 30px;
      border-top: 1px solid #494942;
    }
    .paara-filings h3 { margin: 0; color: #ff7a57; font-size: 12px; font-weight: 800; letter-spacing: .12em; text-transform: uppercase; }
    .paara-filings p { margin: 0; color: #c7c2b8; font-size: 16px; }
    .paara-filings .filing-note { margin-top: 12px; color: #8d887f; font-size: 12.5px; }

    .contact { padding: 94px 0; background: var(--signal); color: var(--white); }
    .contact-grid {
      display: grid;
      grid-template-columns: minmax(0, 1.25fr) minmax(320px, .75fr);
      gap: 70px;
      align-items: end;
    }
    .contact h2 {
      max-width: 840px;
      margin: 0;
      font-family: Georgia, "Times New Roman", serif;
      font-size: 80px;
      font-weight: 400;
      line-height: .98;
    }
    .contact-copy p { margin: 0 0 24px; font-size: 17px; }
    .contact .button { background: var(--white); color: var(--ink); }
    .contact .button:hover { background: var(--ink); color: var(--white); }
    .contact-links { display: flex; flex-wrap: wrap; gap: 18px 24px; margin-top: 24px; font-size: 13px; font-weight: 700; }
    .contact-links a { border-bottom: 1px solid rgba(255,255,255,.65); }

    footer { background: var(--ink); color: #b8b3a9; }
    .footer-inner {
      min-height: 86px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 24px;
      font-size: 12px;
    }

    .reveal { opacity: 0; transform: translateY(24px); transition: opacity 620ms ease, transform 620ms cubic-bezier(.2,.7,.2,1); }
    .reveal.is-visible { opacity: 1; transform: none; }
    @keyframes rise { from { opacity: 0; transform: translateY(22px); } to { opacity: 1; transform: none; } }
    @keyframes settle { from { opacity: .4; transform: scale(1.06); } to { opacity: 1; transform: scale(1.015); } }

    @media (max-width: 940px) {
      .nav-links {
        position: fixed;
        inset: var(--nav) 0 auto;
        display: none;
        padding: 24px;
        background: var(--ink);
        border-top: 1px solid rgba(255,255,255,.1);
      }
      .nav-links.is-open { display: grid; gap: 0; }
      .nav-links a { padding: 16px 0; border-bottom: 1px solid rgba(255,255,255,.12); font-size: 18px; }
      .menu-button { display: inline-flex; }
      .hero-copy { width: 68%; }
      .hero h1 { font-size: 86px; }
      .hero-line { font-size: 52px; }
      .hero-summary { font-size: 18px; }
      .hero-role { display: none; }
      .section-header { grid-template-columns: 118px 1fr; gap: 30px; }
      .section-title { font-size: 56px; }
      .section-lede { font-size: 20px; }
      .perspective-grid, .paara-grid { gap: 52px; }
      .talk-title { font-size: 31px; }
      .talk-detail { grid-template-columns: 58px minmax(0, 1fr); }
      .talk-detail .talk-meta { grid-column: 2; }
      .paara-word { font-size: 112px; }
      .paara-steps { grid-template-columns: repeat(4, 1fr); }
      .paara-step:nth-child(4) { border-right: 0; }
      .paara-step:nth-child(-n+3), .paara-step:nth-child(4) { border-bottom: 1px solid #494942; }
      .bio-grid { gap: 54px; }
      .bio-copy .intro { font-size: 34px; }
      .work-item { grid-template-columns: 120px 1fr 80px; }
      .work-item h3 { font-size: 22px; }
      .contact h2 { font-size: 64px; }
    }

    @media (max-width: 720px) {
      :root { --nav: 60px; }
      .shell { width: min(100% - 32px, var(--max)); }
      .brand { font-size: 12px; }
      .hero { min-height: calc(100svh - 96px); }
      .hero-image { object-position: 63% 25%; opacity: .82; }
      .hero::before { background: rgba(17,17,15,.56); }
      .hero::after { height: 60%; background: linear-gradient(0deg, rgba(17,17,15,.97), rgba(17,17,15,.12)); }
      .hero-inner { min-height: calc(100svh - 96px); align-items: end; padding: 80px 0 42px; }
      .hero-copy { width: 100%; }
      .hero h1 { max-width: 9ch; font-size: 64px; }
      .hero-line { max-width: 10ch; margin-top: 18px; font-size: 40px; }
      .hero-kicker { margin-bottom: 14px; font-size: 11px; }
      .hero-summary { max-width: 32ch; margin-top: 20px; font-size: 16px; }
      .hero-actions { margin-top: 24px; gap: 10px; }
      .button { min-height: 44px; padding: 10px 15px; font-size: 13px; }
      .proof-inner { grid-template-columns: 1fr; padding: 12px 0; }
